---
interface Props {
  title?: string;
  lang?: string;
}
const { title = 'PASSUS', lang = 'es' } = Astro.props;
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="Body">
      <slot />
    </div>
    <script src="/scripts/easter-egg.js" is:inline></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
