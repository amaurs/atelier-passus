---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import '../styles/hero.css';

const videos = ["288635294", "288635232", "356267330", "288635258"];
const day = Math.floor((Date.UTC(new Date().getFullYear(), new Date().getMonth(), new Date().getDate()) - Date.UTC(new Date().getFullYear(), 0, 0)) / 86400000);
const videoId = videos[day % videos.length];
const vimeoSrc = `https://player.vimeo.com/video/${videoId}?background=1&muted=1&loop=1&autoplay=1&quality=720p&transparent=0&portrait=0&title=0`;
---
<Base title="PASSUS">
  <section class="Hero">
    <iframe
      src={vimeoSrc}
      title="Atelier-Passus"
      frameborder="0"
      allow="autoplay; fullscreen"
      allowfullscreen
    ></iframe>
    <span style="position:absolute;top:0;left:0;width:100%;height:100%;background-color:black;opacity:0.1"></span>
    <a href="/projects">
      <Logo style="fill:white" />
    </a>
    <a href="/projects">
      <p>atelier /</p>
    </a>
  </section>
</Base>
