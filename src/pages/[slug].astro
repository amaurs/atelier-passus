---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ImageGallery from '../components/ImageGallery.tsx';
import Menu from '../components/Menu.tsx';
import '../styles/renderhelper.css';
import '../styles/card.css';
import '../styles/menu.css';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map(p => ({ params: { slug: p.data.src }, props: { project: p.data } }));
}

const { project } = Astro.props;

// Eagerly load all project images for Astro optimization
const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpg,jpeg,png,gif}', { eager: true });

// Build image data array for the React island
const imageData = project.images.map((img, i) => {
  if (img.type === 'video') {
    return { type: 'video' as const, vimeoId: img.vimeoId!, index: i };
  }
  const key = `/src/assets/images/${img.path}`;
  const resolved = allImages[key]?.default;
  return { type: 'image' as const, src: resolved?.src ?? '', width: resolved?.width ?? 0, height: resolved?.height ?? 0, index: i };
});
---
<Base title={project.title ? `Atelier Passus — ${project.title}` : 'Atelier Passus'}>
  <Menu client:load />
  <ImageGallery
    client:load
    images={imageData}
    title={project.title ?? ''}
    headers={project.headers}
    paragraphs={project.paragraphs}
  />
</Base>
