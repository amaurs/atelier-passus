---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Menu from '../../components/Menu.tsx';
import { t } from '../../i18n';
import type { Locale } from '../../i18n';
import '../../styles/grid.css';
import '../../styles/menu.css';

const locale: Locale = 'fr';
const allProjects = await getCollection('projects');
const projects = allProjects
  .filter(p => p.data.year !== null)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const icons = import.meta.glob<{ default: ImageMetadata }>('/src/assets/icons/*.jpg', { eager: true });

function getIcon(cardIcon: string | null) {
  if (!cardIcon) return null;
  const filename = cardIcon.replace('iconos/', '');
  const key = `/src/assets/icons/${filename}`;
  return icons[key]?.default ?? null;
}
---
<Base title="Atelier Passus — Projets" lang="fr">
  <Menu client:load isGallery={true} locale={locale} currentPath="/projects" />
  <section id="projects" class="Grid-container">
    <div class="Grid">
      {projects.map(p => {
        const icon = getIcon(p.data.cardIcon);
        const card = t(p.data.card, locale);
        return (
          <a href={`/fr/${p.data.src}`} class="Grid-cell">
            {icon && <Image src={icon} alt={card} widths={[300, 600]} sizes="(min-width: 1000px) 25vw, (min-width: 600px) 50vw, 100vw" />}
            <span class="Grid-mask"></span>
            <p set:html={card} />
          </a>
        );
      })}
    </div>
  </section>
  <a href="/fr">
    <Logo style="position:fixed;bottom:25px;right:25px;width:50px;z-index:4" />
  </a>
</Base>
